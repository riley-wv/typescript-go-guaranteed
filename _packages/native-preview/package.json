{
    "private": true,
    "name": "@ts-guaranteed/tsgo",
    "version": "0.0.0",
    "license": "Apache-2.0",
    "author": "Webb Ventures",
    "homepage": "https://github.com/riley-wv/typescript-go-guaranteed#readme",
    "description": "TypeScript native compiler preview with ts-guaranteed runtime guarantee checks",
    "keywords": [
        "TypeScript",
        "compiler",
        "language",
        "javascript",
        "tsgo",
        "runtime-guarantees"
    ],
    "bugs": {
        "url": "https://github.com/riley-wv/typescript-go-guaranteed/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/riley-wv/typescript-go-guaranteed.git",
        "directory": "_packages/native-preview"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "preferUnplugged": true,
    "engines": {
        "node": ">=16.20.0"
    },
    "files": [
        "bin",
        "lib",
        "dist",
        "vendor"
    ],
    "bin": {
        "tsgo": "./bin/tsgo.js"
    },
    "exports": {
        "./package.json": "./package.json",
        "./unstable/sync": {
            "@typescript/source": "./src/api/sync/api.ts",
            "default": "./dist/api/sync/api.js"
        },
        "./unstable/async": {
            "@typescript/source": "./src/api/async/api.ts",
            "default": "./dist/api/async/api.js"
        },
        "./unstable/fs": {
            "@typescript/source": "./src/api/fs.ts",
            "default": "./dist/api/fs.js"
        },
        "./unstable/proto": {
            "@typescript/source": "./src/api/proto.ts",
            "default": "./dist/api/proto.js"
        },
        "./unstable/ast": {
            "@typescript/source": "./src/ast/index.ts",
            "default": "./dist/ast/index.js"
        },
        "./unstable/ast/is": {
            "@typescript/source": "./src/ast/is.ts",
            "default": "./dist/ast/is.js"
        },
        "./unstable/ast/factory": {
            "@typescript/source": "./src/ast/factory.generated.ts",
            "default": "./dist/ast/factory.generated.js"
        },
        "./unstable/ast/utils": {
            "@typescript/source": "./src/ast/utils.ts",
            "default": "./dist/ast/utils.js"
        },
        "./unstable/ast/scanner": {
            "@typescript/source": "./src/ast/scanner.ts",
            "default": "./dist/ast/scanner.js"
        },
        "./unstable/ast/visitor": {
            "@typescript/source": "./src/ast/visitor.ts",
            "default": "./dist/ast/visitor.js"
        },
        "./unstable/ast/clone": {
            "@typescript/source": "./src/ast/clone.ts",
            "default": "./dist/ast/clone.js"
        }
    },
    "imports": {
        "#getExePath": "./lib/getExePath.js",
        "#enums/*": {
            "@typescript/source": {
                "types": "./src/enums/*.enum.ts",
                "default": "./src/enums/*.ts"
            },
            "types": "./dist/enums/*.enum.d.ts",
            "default": "./dist/enums/*.js"
        },
        "#vscode-jsonrpc/node": "./vendor/vscode-jsonrpc/lib/node/main.js"
    },
    "scripts": {
        "node": "node --experimental-strip-types --no-warnings --conditions @typescript/source",
        "generate": "bun run generate:ast && bun run generate:encoder && bun run generate:enums && bun run generate:sync",
        "generate:ast": "node --experimental-strip-types --no-warnings ../../_scripts/generate-ts-ast.ts",
        "generate:encoder": "bun run node -- ../../_scripts/generate-encoder.ts",
        "generate:sync": "bun run node -- scripts/generateSync.ts",
        "generate:enums": "bunx hereby generate:enums --herebyfile ../../Herebyfile.mjs",
        "prebuild": "bun run generate",
        "build": "tsc -b",
        "prebuild:test": "bun run generate",
        "build:test": "tsc -b test",
        "test:only": "bun run node -- --test './test/**/*.test.ts'",
        "pretest": "bun run generate",
        "test": "bun run test:only"
    },
    "devDependencies": {
        "@types/node": "^25.9.1",
        "tinybench": "^6.0.2",
        "vscode-jsonrpc": "^9.0.0-next.11"
    }
}
